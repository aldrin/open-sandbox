# OpenCode Development Container
# Provides a development environment for OpenCode backed by OpenRouter, with an
# egress firewall and a domain-allowlisting proxy.

FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

# Install system-level dependencies for all sections below.
#   Base:     curl, git, ca-certificates, unzip (fnm unzips its own release)
#   Agents:   ripgrep, jq, nodejs, npm (system copies; the agent's own Node
#             LTS arrives with fnm in the TypeScript section below)
#   Egress:   nftables (firewall)
#   Privdrop: util-linux (setpriv)
#   Rust:     build-essential, pkg-config, libssl-dev
#   Python:   python3, python3-dev
#   Docs:     fonts-ibm-plex
#   Editor:   emacs-nox
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates unzip \
    ripgrep jq nodejs npm \
    nftables \
    util-linux \
    build-essential pkg-config libssl-dev \
    python3 python3-dev \
    fonts-ibm-plex \
    emacs-nox \
    && rm -rf /var/lib/apt/lists/*

# Pandoc (apt version lags behind; install pre-built binary from GitHub).
# --no-same-owner so the archive's uid does not leak through: extracted as
# root, these files land root-owned instead of owned by whatever uid the
# archive happens to carry.
RUN curl -sSL https://github.com/jgm/pandoc/releases/download/3.9.0.2/pandoc-3.9.0.2-linux-arm64.tar.gz \
    | tar -xz --strip-components=1 --no-same-owner -C /usr/local

# Typst typesetting compiler (not packaged in Ubuntu; pre-built binary from GitHub)
RUN curl -sSL https://github.com/typst/typst/releases/latest/download/typst-aarch64-unknown-linux-musl.tar.xz \
    | tar -xJ --strip-components=1 --no-same-owner -C /usr/local/bin

# Two users. The agent runs as 'agent' and never gets the network directly.
# 'egress' owns the only UID the firewall lets out, and runs the allowlist
# proxy. Splitting them is what makes the nftables rule expressible.
RUN useradd -m -d /home/agent -s /bin/bash agent \
    && useradd -r -u 900 -M -d /nonexistent -s /usr/sbin/nologin egress

USER agent

# PATH for tools installed to ~/.local/bin and ~/.cargo/bin
ENV PATH="/home/agent/.local/bin:/home/agent/.cargo/bin:${PATH}"

# Ensure 256-color support; not always inherited from the host terminal
ENV TERM=xterm-256color
ENV EDITOR=emacs

# =============================================================================
# Rust
# =============================================================================

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain stable \
    --component rust-analyzer \
    --component rust-src \
    --component clippy \
    --component rustfmt \
    --component llvm-tools

# Nightly toolchain with rust-src for cargo-fuzz (libFuzzer requires nightly)
RUN rustup toolchain install nightly --component rust-src

# cargo-fuzz for running fuzz targets; cargo-llvm-cov for code coverage
RUN cargo install cargo-fuzz cargo-llvm-cov

# Rust → WebAssembly. wasm-pack drives a build end to end, and wasm-bindgen-cli
# produces the JS glue for #[wasm_bindgen] crates (its version has to match the
# wasm-bindgen crate a project depends on). The target's std is a rustup
# component, not a crate, so it is fetched here at build time: the agent's
# egress allowlist has no static.rust-lang.org, so `rustup target add` would
# fail at runtime.
RUN rustup target add wasm32-unknown-unknown \
    && cargo install wasm-pack wasm-bindgen-cli

# Shared target directory keeps build artifacts out of the project volume
ENV CARGO_TARGET_DIR="/home/agent/cargo-target"

# =============================================================================
# Python
# =============================================================================

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Use container-local directories to avoid conflicts with host macOS packages
ENV UV_PROJECT_ENVIRONMENT="/home/agent/.venv"
ENV UV_CACHE_DIR="/home/agent/.cache/uv"

RUN uv tool install basedpyright \
    && ln -s basedpyright-langserver /home/agent/.local/bin/pyright-langserver

# A week-long cooldown, mirroring the npm/pnpm policy: uv will not resolve a
# distribution uploaded in the last week. A project escapes one package with
# exclude-newer-package in its pyproject.toml or uv.toml.
RUN install -d /home/agent/.config/uv \
    && printf '%s\n' 'exclude-newer = "7 days"' > /home/agent/.config/uv/uv.toml

# =============================================================================
# Node.js / TypeScript
# =============================================================================
#
# fnm manages Node the way rustup manages Rust toolchains: the agent's own Node
# LTS lives under its home, while the apt nodejs/npm above stay only to install
# OpenCode into the system prefix later. The pnpm store and the npm cache go
# under ~/.cache, mirroring UV_CACHE_DIR and CARGO_TARGET_DIR, so only project
# sources land on the mounted volume.

RUN curl -fsSL https://fnm.vercel.app/install \
    | bash -s -- --install-dir /home/agent/.local/bin --skip-shell

ENV FNM_DIR="/home/agent/.local/share/fnm"
ENV NPM_CONFIG_PREFIX="/home/agent/.local"
ENV NPM_CONFIG_CACHE="/home/agent/.cache/npm"
ENV PNPM_HOME="/home/agent/.local/share/pnpm"
# fnm's 'default' alias is the stable path to the selected Node, so node/npm
# are on PATH without the shell hook `fnm env` would otherwise install.
ENV PATH="/home/agent/.local/share/fnm/aliases/default/bin:/home/agent/.local/share/pnpm:/home/agent/.local/bin:/home/agent/.cargo/bin:${PATH}"

# Install the current Node LTS and point the 'default' alias at it. fnm resolves
# the alias from an installed version, so name it explicitly rather than asking
# for the 'lts-latest' alias, which does not exist until a default is set.
RUN fnm install --lts \
    && fnm default "$(fnm ls | grep -oE 'v[0-9]+(\.[0-9]+){2}' | sort -V | tail -1)"

# TypeScript 7 (the native tsgo compiler), a TypeScript language server for
# manual use, Biome for lint + format, and pnpm as the project package manager.
# OpenCode v2 does not run language servers itself, but the tools stay available
# to the agent. Vite and Vitest are installed per project.
RUN npm install -g \
      typescript \
      typescript-language-server \
      @biomejs/biome \
      pnpm \
    && npm cache clean --force

# Safe supply-chain defaults. A newly published version is the shape of most
# npm attacks, so neither manager resolves a version younger than a week, and
# pnpm additionally fails closed rather than silently substituting an older one,
# refuses a trust downgrade, and keeps exotic (git/tarball) transitive sources
# out. npm has no per-package script allowlist, so it simply runs none.
# pnpm's window is minutes and, since v11, lives in its global config.yaml
# rather than .npmrc; npm's is days and lives in .npmrc.
RUN install -d /home/agent/.config/pnpm \
    && printf '%s\n' \
         'minimumReleaseAge: 10080' \
         'minimumReleaseAgeStrict: true' \
         'trustPolicy: no-downgrade' \
         'blockExoticSubdeps: true' \
         > /home/agent/.config/pnpm/config.yaml \
    && printf '%s\n' \
         'min-release-age=7' \
         'ignore-scripts=true' \
         > /home/agent/.npmrc

# =============================================================================
# DuckDB
# =============================================================================

RUN curl https://install.duckdb.org | sh

# =============================================================================
# OpenCode (last among installs — changes most often, protects the layer cache)
# =============================================================================

USER root

# OpenCode v2 ships a native binary. The installer writes to $HOME/.opencode/bin
# and edits shell startup files unless told not to, so give it a throwaway HOME
# and copy the binary into the system prefix. Root owns /usr/local/bin, which
# keeps the agent from rewriting the binary. Tracks the latest v2 release.
RUN curl -fsSL https://opencode.ai/v2/install \
    | HOME=/tmp/opencode-install SHELL=/bin/bash bash -s -- --no-modify-path \
    && install -m 0755 /tmp/opencode-install/.opencode/bin/opencode /usr/local/bin/opencode \
    && rm -rf /tmp/opencode-install

# OpenCode Power Pack: source of the code-review, security-review, and related
# skills ported from Anthropic's Claude Code plugins. Installed into the image so
# OpenCode reads the skill files from the global node_modules instead of fetching
# them at startup; opencode.json selects the specific skill directories it wants
# under skills, so the rest of the catalog stays out of context. Tracks the
# latest release, so a rebuild picks up the newest skill content.
RUN NPM_CONFIG_PREFIX=/usr/local NPM_CONFIG_CACHE=/root/.npm \
      npm install -g @waybarrios/opencode-power-pack@latest \
    && npm cache clean --force

# =============================================================================
# Workspace — root-owned config
# =============================================================================
#
# The agent runs unprivileged, so root-owned files are read-only to it. That
# stops accidental edits. It does not stop a deliberate agent from renaming
# ~/.config/opencode aside and writing its own, because the agent owns
# ~/.config. The firewall and proxy, not these files, are the boundary. The
# entrypoint, proxy, allowlist, and verify scripts live under root-owned
# directories, so they cannot be moved aside either.

COPY entrypoint.sh /usr/local/bin/open-sandbox-entrypoint
COPY egress-proxy.py /usr/local/lib/open-sandbox/egress-proxy.py
COPY allowlist.txt /etc/open-sandbox/allowlist.txt
COPY sandbox-checks.py /usr/local/lib/open-sandbox/sandbox-checks.py
COPY sandbox-tools.py /usr/local/lib/open-sandbox/sandbox-tools.py

# OpenCode: global config, global context file, slash commands, and CLI settings
COPY opencode.json /home/agent/.config/opencode/opencode.json
COPY AGENTS.md /home/agent/.config/opencode/AGENTS.md
COPY cli.json /home/agent/.config/opencode/cli.json
COPY commands/ /home/agent/.config/opencode/commands/

RUN chmod 0755 /usr/local/bin/open-sandbox-entrypoint \
                /usr/local/lib/open-sandbox/egress-proxy.py \
 && chown -R root:root /usr/local/bin /usr/local/lib \
 && chmod 0444 /etc/open-sandbox/allowlist.txt \
 && chown -R root:root /home/agent/.config/opencode \
 && chmod -R a-w /home/agent/.config/opencode \
 && chmod 0644 /usr/local/lib/open-sandbox/sandbox-checks.py \
               /usr/local/lib/open-sandbox/sandbox-tools.py \
 && chown agent:agent /home/agent /home/agent/.config \
 && chmod 0755 /home/agent /home/agent/.config \
 && install -d -o agent -g agent -m 0700 /home/agent/.local/share/opencode \
 && install -d -o agent -g agent -m 0755 /tmp/agent

ENV TMPDIR=/tmp/agent

WORKDIR /home/agent/code

ENTRYPOINT ["/usr/local/bin/open-sandbox-entrypoint"]
# OpenCode v2's shared background service persists its own service.json in
# ~/.config/opencode, which is deliberately root-owned and read-only. A
# standalone server needs no such file and is the right shape for a disposable,
# single-user VM.
CMD ["opencode", "--standalone"]
