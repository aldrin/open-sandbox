{
  "$schema": "https://opencode.ai/config.json",

  "enabled_providers": ["openrouter"],

  "model": "openrouter/~deepseek/deepseek-flash-latest",
  "small_model": "openrouter/~deepseek/deepseek-flash-latest",

  "instructions": ["/home/agent/.config/opencode/AGENTS.md"],

  "skills": {
    "paths": [
      "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/code-reviewer",
      "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/security-review",
      "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/vuln-report",
      "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/ai-slop"
    ]
  },

  "autoupdate": false,
  "share": "disabled",

  "experimental": {
    "openTelemetry": false
  },

  "formatter": true,
  "lsp": true,

  "provider": {
    "openrouter": {
      "models": {
        "~deepseek/deepseek-flash-latest": {},
        "~deepseek/deepseek-pro-latest": {}
      }
    }
  },

  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/",
      "oauth": false,
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:/home/agent/.local/share/opencode/tavily-key}"
      }
    }
  },

  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",

      "git commit*": "deny",
      "git push*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git restore*": "deny",
      "git branch*": "deny",
      "git tag*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git am*": "deny",
      "git apply*": "deny",
      "git filter-branch*": "deny",
      "git update-ref*": "deny",
      "git reflog*": "deny",
      "git gc*": "deny",
      "git worktree*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny",
      "git clone*": "deny",
      "git submodule*": "deny",

      "cargo add*": "ask",
      "cargo remove*": "ask",
      "cargo install*": "ask",
      "uv add*": "ask",
      "uv remove*": "ask",
      "uv pip install*": "ask",
      "pip install*": "ask",
      "pip3 install*": "ask",

      "npm*": "deny",
      "npx*": "deny",
      "pnpm*": "deny",
      "yarn*": "deny"
    },
    "edit": {
      "*": "allow",
      "**/Cargo.toml": "ask",
      "**/Cargo.lock": "ask",
      "**/pyproject.toml": "ask",
      "**/uv.lock": "ask",
      "**/requirements*.txt": "ask",
      "**/package.json": "ask",
      "**/package-lock.json": "ask"
    },
    "external_directory": "deny"
  }
}
