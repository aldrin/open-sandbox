{
  "$schema": "https://opencode.ai/config.json",

  "enabled_providers": ["openrouter", "mlx"],

  "model": "openrouter/~deepseek/deepseek-flash-latest",

  "agents": {
    "title": {
      "model": "openrouter/~deepseek/deepseek-flash-latest"
    }
  },

  "instructions": ["/home/agent/.config/opencode/AGENTS.md"],

  "skills": [
    "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/code-reviewer",
    "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/security-review",
    "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/vuln-report",
    "/usr/local/lib/node_modules/@waybarrios/opencode-power-pack/skills/ai-slop"
  ],

  "update": "disable",
  "share": "disabled",

  "formatter": true,

  "providers": {
    "openrouter": {
      "settings": {
        "apiKey": "{file:/home/agent/.local/share/opencode/openrouter-key}"
      },
      "models": {
        "~deepseek/deepseek-flash-latest": {},
        "~deepseek/deepseek-pro-latest": {}
      }
    },
    "mlx": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "MLX (Mac host)",
      "settings": {
        "baseURL": "http://host.container.internal:27182/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "default_model": {
          "name": "MLX (Mac host)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "variants": [
            {
              "id": "think",
              "body": { "chat_template_kwargs": { "enable_thinking": true } }
            }
          ]
        }
      }
    }
  },

  "mcp": {
    "servers": {
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:/home/agent/.local/share/opencode/tavily-key}"
        }
      }
    }
  },

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },

    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git cherry-pick*", "effect": "deny" },
    { "action": "shell", "resource": "git revert*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "deny" },
    { "action": "shell", "resource": "git switch*", "effect": "deny" },
    { "action": "shell", "resource": "git restore*", "effect": "deny" },
    { "action": "shell", "resource": "git branch*", "effect": "deny" },
    { "action": "shell", "resource": "git tag*", "effect": "deny" },
    { "action": "shell", "resource": "git stash*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "git am*", "effect": "deny" },
    { "action": "shell", "resource": "git apply*", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "deny" },
    { "action": "shell", "resource": "git update-ref*", "effect": "deny" },
    { "action": "shell", "resource": "git reflog*", "effect": "deny" },
    { "action": "shell", "resource": "git gc*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree*", "effect": "deny" },
    { "action": "shell", "resource": "git fetch*", "effect": "deny" },
    { "action": "shell", "resource": "git pull*", "effect": "deny" },
    { "action": "shell", "resource": "git clone*", "effect": "deny" },
    { "action": "shell", "resource": "git submodule*", "effect": "deny" },

    { "action": "shell", "resource": "cargo add*", "effect": "ask" },
    { "action": "shell", "resource": "cargo remove*", "effect": "ask" },
    { "action": "shell", "resource": "cargo install*", "effect": "ask" },
    { "action": "shell", "resource": "uv add*", "effect": "ask" },
    { "action": "shell", "resource": "uv remove*", "effect": "ask" },
    { "action": "shell", "resource": "uv pip install*", "effect": "ask" },
    { "action": "shell", "resource": "pip install*", "effect": "ask" },
    { "action": "shell", "resource": "pip3 install*", "effect": "ask" },

    { "action": "shell", "resource": "npm install*", "effect": "ask" },
    { "action": "shell", "resource": "npm i *", "effect": "ask" },
    { "action": "shell", "resource": "npm ci*", "effect": "ask" },
    { "action": "shell", "resource": "npm add*", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "npm update*", "effect": "ask" },
    { "action": "shell", "resource": "npm link*", "effect": "ask" },
    { "action": "shell", "resource": "npx*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm install*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm i *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm remove*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm update*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm link*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm dlx*", "effect": "ask" },
    { "action": "shell", "resource": "yarn add*", "effect": "ask" },
    { "action": "shell", "resource": "yarn install*", "effect": "ask" },
    { "action": "shell", "resource": "yarn remove*", "effect": "ask" },
    { "action": "shell", "resource": "corepack*", "effect": "ask" },

    { "action": "edit", "resource": "**/Cargo.toml", "effect": "ask" },
    { "action": "edit", "resource": "**/Cargo.lock", "effect": "ask" },
    { "action": "edit", "resource": "**/pyproject.toml", "effect": "ask" },
    { "action": "edit", "resource": "**/uv.lock", "effect": "ask" },
    { "action": "edit", "resource": "**/requirements*.txt", "effect": "ask" },
    { "action": "edit", "resource": "**/package.json", "effect": "ask" },
    { "action": "edit", "resource": "**/package-lock.json", "effect": "ask" },
    { "action": "edit", "resource": "**/pnpm-lock.yaml", "effect": "ask" },
    { "action": "edit", "resource": "**/yarn.lock", "effect": "ask" },
    { "action": "edit", "resource": "**/tsconfig.json", "effect": "ask" }
  ]
}
